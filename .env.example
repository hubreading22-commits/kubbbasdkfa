# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where Kudumba Vault is hosted.
APP_URL="http://localhost:3000"

# DATABASE & SUPABASE (PostgreSQL with Row-Level Security)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kudumba_vault?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kudumba_vault?schema=public"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SECURITY & APPLICATION-LEVEL ENCRYPTION (32-byte hex key for AES-256-GCM)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CRON_SECRET="kudumba-cron-secret-token"

# I18N & PUBLIC CONTACT
VITE_DEFAULT_LOCALE="ml"
VITE_WHATSAPP_SUPPORT_NUMBER="919447000000"

# MESSAGING & STORAGE PROVIDERS (Optional in dev sandbox)
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
S3_BUCKET_NAME="kudumba-vault-private-mumbai"
S3_REGION="ap-south-1"

